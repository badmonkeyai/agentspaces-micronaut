<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.badmonkey.agentspaces</groupId>
    <artifactId>agentspaces-micronaut-parent</artifactId>
    <version>0.3.0</version>
  </parent>

  <artifactId>agentspaces-micronaut-processor</artifactId>
  <name>AgentSpaces Micronaut :: Annotation Processor</name>
  <description>
    Compile-time support for AgentSpaces annotations in Micronaut: maps the
    core method annotations (@SpaceTake, @SpaceNotify, @BidFunction, @Ballot,
    @OrderedTake, @OnDecision, and the 0.3.0 set @SpaceJoin, @Propose,
    @OnEstimate, @SpaceReduce) to @Executable and @ReflectiveAccess, so a bean
    with only method annotations enrolls at startup and native images keep the
    reflection the binder needs. Goes on the annotation-processor path only.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.micronaut</groupId>
      <artifactId>micronaut-core-processor</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- This module is itself a processor: no Micronaut processing of its sources. -->
          <proc>none</proc>
          <annotationProcessorPaths combine.self="override"/>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
